DB_USUARIO=nepos
DB_CONTRASENA=CAMBIAR_ESTA_CLAVE
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_NOMBRE=pos_db

# Opcional. Si se omite, Windows usa C:\ProgramData\NEPOS.
# NEPOS_DATOS_DIR=C:/ProgramData/NEPOS

# Opcional si mysqldump.exe no está en PATH.
# MYSQLDUMP_RUTA=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe

# 168 backups horarios equivalen aproximadamente a 7 días.
MAXIMO_BACKUPS=168
