DB_USUARIO=root
DB_CONTRASENA=loro2004
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_NOMBRE=pos_db

# Opcional. Si se omite, Windows usa %LOCALAPPDATA%\NEPOS.
NEPOS_DATOS_DIR=C:\NEPOS\datos

# Opcional si mysqldump.exe no está en PATH.
MYSQLDUMP_RUTA=C:\Program Files\MySQL\MySQL Server 9.3\bin\mysqldump.exe

# 168 backups horarios equivalen aproximadamente a 7 días.
MAXIMO_BACKUPS=168
